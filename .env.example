# Copiază acest fișier în `.env` și schimbă valorile.
#   cp .env.example .env
# .env NU se comite (e în .gitignore).

# Portul serverului
PORT=3000

# Credențialele de admin (login real)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=schimba-ma-cu-o-parola-buna

# Secret pentru semnarea cookie-ului de sesiune — pune ceva lung și aleator.
# Generează unul: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=pune-aici-un-secret-lung-si-aleator

# --- Domeniu și SEO ---
# Domeniul canonic. Canonical, OG, JSON-LD, sitemap și robots îl folosesc mereu;
# pe Vercel orice alt host (*.vercel.app, www) face redirect 301 spre el.
# Gol local = se folosește host-ul cererii (localhost).
# SITE_URL=https://profesionalesmadrid.es

# Pragul de indexare: o pagină de listare intră în Google și în sitemap doar
# de la atâtea firme în sus (sub prag: noindex,follow). Implicit 3.
# MIN_LISTING=3

# Ce sub-sitemap-uri publică /sitemap.xml (lansare în valuri). Gol = toate.
# Grupuri: principales,servicios,distritos,municipios,barrios,metro,historias,negocios
# SITEMAP_TYPES=principales,servicios,distritos,historias

# --- Contact ---
# Email general (aviso legal, privacidad, contacto). Clienții NU văd telefon.
SITE_EMAIL=hola@profesionalesmadrid.es
# Telefon/WhatsApp afișat DOAR pentru profesioniști (alta, reclamar ficha,
# historias). Format internațional, ca wa.me să funcționeze.
PRO_PHONE=+34 663 291 101

# --- Date firmă pentru paginile legale (Aviso legal / Privacidad / etc.) ---
# Valorile implicite din cod sunt deja setate (Refluxe Loial SRL, Bacău,
# CUI 49608691). Suprascrie-le aici doar dacă se schimbă.
# LEGAL_RAZON=Refluxe Loial SRL
# LEGAL_NIF=49608691
# LEGAL_DOMICILIO=Bacău, Rumanía

# --- Persistență durabilă cu Supabase Postgres (pentru Vercel) ---
# Connection string din Supabase → Project Settings → Database → Connection
# string → "Transaction pooler" (recomandat pe serverless, portul 6543).
# Dacă e setat: baza rulează în memorie și se sincronizează cu Postgres.
# Dacă NU e setat: local folosește SQLite pe disc; pe Vercel, memorie efemeră.
# DATABASE_URL=postgresql://postgres.xxxx:PAROLA@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# (opțional) câte conexiuni pg per instanță serverless (implicit 1)
# PG_POOL_MAX=1

# --- Doar pentru rulare locală pe disc (fără Supabase) ---
# DB_PATH=server/data.db
# UPLOADS_DIR=uploads

# --- Token pentru push de businesses din CRM „100k MRR" ---
# CRM-ul trimite negocios prin headerul x-api-token. Pune aceeași valoare și în
# prospectquest/.env.local la DIRECTORY_API_TOKEN. Gol = push dezactivat.
# Drepturi minime: tokenul permite DOAR POST /api/businesses (nu export/import/
# reset/leaduri/clasamente — acelea cer sesiune de admin).
# Generează unul: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_TOKEN=pune-acelasi-token-ca-in-CRM

# --- Notificare leaduri (cereri de presupuesto) — toate opționale ---
# Dacă niciuna nu e setată, leadul rămâne oricum în DB + în inbox-ul din /admin.
# 1) Webhook generic (Zapier / Make / n8n / Slack / Discord) — primește JSON.
# LEADS_WEBHOOK_URL=https://hooks.zapier.com/...
# 2) Telegram (mesaj instant pe telefon).
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
# 3) Email prin Resend (https://resend.com).
# RESEND_API_KEY=re_...
# LEADS_EMAIL_TO=tu@correo.com
# LEADS_EMAIL_FROM=Leads <onboarding@resend.dev>

# --- Analytics (opțional; se încarcă DOAR după consimțământul de cookies) ---
# Alege UNA. Fără ele, nu se emite niciun script de analytics.
# Plausible (privacy-friendly): pune domeniul din contul Plausible.
# PLAUSIBLE_DOMAIN=reformas-madrid.vercel.app
# Google Analytics 4: pune ID-ul de măsurare.
# GA4_ID=G-XXXXXXXXXX

# --- Imagini în Supabase Storage (fotos fișe + povești) ---
# Fără ele: local pe disc (uploads/), pe Vercel inline în baza de date (lent).
# Cheia service_role NU se pune niciodată în frontend.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...
# SUPABASE_BUCKET=media
